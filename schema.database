-- 1. Users Table: To verify identity during flows (e.g., Password Resets)
CREATE TABLE users (
    user_id INT AUTO_INCREMENT PRIMARY KEY,
    email VARCHAR(255) UNIQUE NOT NULL,
    full_name VARCHAR(100),
    department VARCHAR(50),
    is_active BOOLEAN DEFAULT TRUE,
    last_login DATETIME
);

-- 2. Assets Table: To identify which hardware the user owns
CREATE TABLE assets (
    asset_id VARCHAR(50) PRIMARY KEY, -- e.g., "LAPTOP-X99"
    owner_id INT,
    device_type ENUM('Laptop', 'Mobile', 'Desktop', 'Tablet'),
    os_version VARCHAR(50),
    status ENUM('Online', 'Offline', 'Repair'),
    FOREIGN KEY (owner_id) REFERENCES users(user_id)
);

-- 3. Tickets Table: To track issues created by the AI Agent
CREATE TABLE tickets (
    ticket_id INT AUTO_INCREMENT PRIMARY KEY,
    user_id INT,
    subject VARCHAR(255),
    description TEXT,
    priority ENUM('Low', 'Medium', 'High', 'Critical') DEFAULT 'Medium',
    status ENUM('Open', 'In-Progress', 'Resolved', 'Closed') DEFAULT 'Open',
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,
    FOREIGN KEY (user_id) REFERENCES users(user_id)
);

//user table for filing a ticket and accessing their tickets. 
# add to mcp_app.py
import sqlalchemy as sa

engine = sa.create_engine("mysql+pymysql://user:pass@localhost/it_helpdesk")

@mcp.tool()
def get_user_tickets(email: str) -> list:
    """Retrieves all active tickets for a user from the DB."""
    with engine.connect() as conn:
        result = conn.execute(sa.text(
            "SELECT ticket_id, subject, status FROM tickets "
            "JOIN users ON tickets.user_id = users.user_id "
            "WHERE users.email = :email"
        ), {"email": email})
        return [dict(row) for row in result]

      //creating the knowledge database table
      -- 4. Knowledge Base: For real-time document retrieval (RAG)
CREATE TABLE knowledge_base (
    kb_id INT AUTO_INCREMENT PRIMARY KEY,
    category VARCHAR(50), -- e.g., 'VPN', 'Email', 'Hardware'
    question_text TEXT,
    answer_text TEXT,
    vector_embedding BLOB, -- To store the SBERT embeddings for real-time search
    last_updated TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);

//missing indexing for real-time speed
-- Indexes for millisecond lookups during chat
CREATE INDEX idx_user_email ON users(email);
CREATE INDEX idx_ticket_status ON tickets(status);
CREATE INDEX idx_asset_owner ON assets(owner_id);


      
